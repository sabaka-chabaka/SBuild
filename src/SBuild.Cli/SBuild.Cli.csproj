<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <PackAsTool>true</PackAsTool>
        <ToolCommandName>sbuild</ToolCommandName>
        <PackageOutputPath>$(MSBuildThisFileDirectory)../../nupkgs</PackageOutputPath>

        <Version>1.0.7</Version>

    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Spectre.Console" Version="0.57.3-alpha.0.28" />
      <PackageReference Include="System.CommandLine" Version="2.0.12" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\SBuild.Compilation\SBuild.Compilation.csproj" />
    </ItemGroup>

</Project>
